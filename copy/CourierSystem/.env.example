# Copy these lines into CourierSystem/.env (the real file is NOT committed to git).
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=courier
DB_USER=root
DB_PASSWORD=your-mysql-password

# Secret used to sign login tokens. Must be at least 32 characters and kept private.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=paste-the-generated-text-here

# How long a login lasts: 30m, 12h, 1d, 7d ...
JWT_EXPIRES_IN=1d

# The very first admin account, created on startup if no admin exists yet.
# If the password contains a # sign, wrap it in quotes: ADMIN_PASSWORD="Pass#1234"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-password-of-8-or-more-characters
